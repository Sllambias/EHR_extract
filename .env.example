# Copy to .env at the repo root and set absolute paths. .env is gitignored.

# Hydra's config root. Required by every script — without it --config-name resolves nothing.
EHR_EXTRACT_CONFIGS=/abs/path/to/EHR_extract/configs

# Default output root, referenced as ${oc.env:EHR_EXTRACT_OUTPUTS} by most configs.
EHR_EXTRACT_OUTPUTS=/abs/path/to/EHR_extract/outputs

# Data root, referenced as ${oc.env:EHR_EXTRACT_DATA} by configs/tables_merged/* and
# configs/templates/*. Expected to contain SDS/ and SP/ subdirectories.
EHR_EXTRACT_DATA=/abs/path/to/data_root
